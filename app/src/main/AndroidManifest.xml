<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
>

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="FyndStay"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FyndStay">


        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <activity android:name=".LoginActivity" android:exported="false"/>
        <activity android:name=".RegisterStudentActivity" android:exported="false"/>
        <activity android:name=".RegisterOwnerActivity" android:exported="false"/>
        <activity android:name=".ChooseRoleActivity" android:exported="false"/>
        <activity android:name=".StudentDashboardActivity" android:exported="false"/>
        <activity android:name=".OwnerDashboardActivity" android:exported="false" />
        <activity android:name=".PGDetailActivity" android:exported="false"/>
        <activity android:name=".AddPGActivity" android:exported="false"/>
        <activity android:name=".EditPGActivity" android:exported="false"/>
        <activity android:name=".FiltersActivity" android:exported="false"/>
        <activity android:name=".WishlistActivity" android:exported="false"/>
        <activity android:name=".OwnerRequestsActivity" android:exported="false"/>


    </application>

</manifest>
