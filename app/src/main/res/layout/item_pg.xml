<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="5dp"
    android:backgroundTint="#FFFFFF"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgPG"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="16:9"
            android:background="@color/white" />

        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suggested"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/poppins_semibold"
            android:background="@drawable/bg_badge"
            android:layout_margin="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/imgPG"
            app:layout_constraintStart_toStartOf="@id/imgPG" />

        <TextView
            android:id="@+id/tvPGName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Cozy PG"
            android:textColor="#3C2F2F"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_semibold"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/imgPG"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnWishlist"
            app:layout_constraintHorizontal_bias="0" />

        <ImageButton
            android:id="@+id/btnWishlist"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_not_favorite"
            app:tint="#7B5E57"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/imgPG"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvLocality"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Andheri West"
            android:textColor="#757575"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            app:layout_constraintTop_toBottomOf="@id/tvPGName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvRent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ 15000/month"
            android:textColor="#E85D3D"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tvLocality"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvGender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mixed"
            android:textColor="#7B5E57"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_medium"
            android:background="@drawable/bg_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/tvRent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
